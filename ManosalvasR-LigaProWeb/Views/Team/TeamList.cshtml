@model IEnumerable<ManosalvasR_LigaProWeb.Models.Team>

@{
    ViewData["Title"] = "TeamList";
}

<h1>TeamList</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlayedGames)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WonGames)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LostGames)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TiedGames)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Points)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PlayedGames)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WonGames)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LostGames)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TiedGames)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Points)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
            </td>
        </tr>
}
    </tbody>
</table>
